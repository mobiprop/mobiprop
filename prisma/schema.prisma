// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Mirrors auth.users — id matches the Supabase Auth user id (no FK across schemas).
model Profile {
  id           String     @id @db.Uuid
  email        String     @unique
  fullName     String?    @map("full_name")
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  country      String?
  city         String?
  timezone     String?
  address      String?
  description  String?
  // Private admin-only notes about a staff member (Edit Agent modal) —
  // distinct from `description`, which is the user's own public bio.
  notes        String?
  // Manager/Admin this AGENT reports to (Edit/Add Agent "Team Leader" field).
  teamLeaderId String?    @map("team_leader_id") @db.Uuid
  // Notification / security / locale settings edited from the profile modal.
  preferences  Json?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Google Calendar integration (Integrations page) — tokens stored encrypted
  // (see src/lib/crypto.ts). Presence of googleCalendarRefreshToken is the
  // "connected" flag; no separate boolean needed.
  googleCalendarEmail          String?   @map("google_calendar_email")
  googleCalendarAccessToken    String?   @map("google_calendar_access_token")
  googleCalendarRefreshToken   String?   @map("google_calendar_refresh_token")
  googleCalendarTokenExpiresAt DateTime? @map("google_calendar_token_expires_at")
  googleCalendarConnectedAt    DateTime? @map("google_calendar_connected_at")

  pushSubscriptions PushSubscription[]

  teamLeader  Profile?  @relation("TeamLeadership", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers Profile[] @relation("TeamLeadership")

  invitationsAsTeamLeader AgentInvitation[] @relation("InvitationTeamLeader")

  @@index([teamLeaderId], map: "profiles_team_leader_idx")
  @@map("profiles")
}

// Invitation-based onboarding for staff users (Admin/Manager/Agent).
// Created by an existing staff member; the invited person completes
// registration via /invite/[token] and the role is fixed by the invite.
model AgentInvitation {
  id           String           @id @default(cuid())
  email        String
  role         UserRole
  tokenHash    String           @unique @map("token_hash")
  invitedById  String?          @map("invited_by_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  status       InvitationStatus @default(PENDING)
  firstName    String?          @map("first_name")
  lastName     String?          @map("last_name")
  phone        String?
  location     String?
  notes        String?
  // Manager/Admin picked as this invitee's team leader — applied to the
  // Profile once the invite is accepted (see applyInvitationExtras).
  teamLeaderId String?          @map("team_leader_id") @db.Uuid
  // Storage path (avatars bucket) of a photo picked before the invite is
  // accepted — no Profile id exists yet, so it can't live at its final path.
  // Promoted to the new Profile's avatar path on acceptance.
  avatarPath   String?          @map("avatar_path")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  teamLeader Profile? @relation("InvitationTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)

  @@index([email], map: "agent_invitations_email_idx")
  @@index([status], map: "agent_invitations_status_idx")
  @@index([expiresAt], map: "agent_invitations_expires_at_idx")
  @@index([teamLeaderId], map: "agent_invitations_team_leader_idx")
  @@map("agent_invitations")
}

// Audit trail for security-relevant actions (invitations, staff onboarding,
// and later CRM record changes). entityType/action are strings, not enums, so
// new CRM modules can log without a schema migration. Server-only (RLS deny-all).
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "activity_logs_entity_idx")
  @@index([actorId], map: "activity_logs_actor_id_idx")
  @@index([createdAt], map: "activity_logs_created_at_idx")
  @@map("activity_logs")
}

// In-app notifications (e.g. admins notified of invitation events). Read/written
// only through Prisma on the server (RLS deny-all for client roles).
model Notification {
  id          String    @id @default(cuid())
  recipientId String    @map("recipient_id") @db.Uuid
  type        String
  title       String
  body        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  // Same-origin internal path the in-app row / push click should open.
  actionUrl   String?   @map("action_url")
  // Profile id of the user who triggered the event (null for system events).
  actorId     String?   @map("actor_id") @db.Uuid
  metadata    Json?
  // Idempotency key for scheduled / fan-out events (e.g. CONTRACT_EXPIRING:{id}:30d).
  dedupeKey   String?   @unique @map("dedupe_key")
  readAt      DateTime? @map("read_at")
  // Set when the recipient dismisses the row from their list (kept for audit).
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([recipientId, readAt], map: "notifications_recipient_read_idx")
  @@index([recipientId, dismissedAt], map: "notifications_recipient_dismissed_idx")
  @@index([createdAt], map: "notifications_created_at_idx")
  @@map("notifications")
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

// A browser/device push subscription. One user may have many (one per
// browser/device). endpoint + keys are sensitive; the table is server-only
// (RLS deny-all) and reached exclusively through authenticated route handlers.
model PushSubscription {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.Uuid

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent   String? @map("user_agent")
  browser     String?
  platform    String?
  deviceLabel String? @map("device_label")

  isActive      Boolean   @default(true) @map("is_active")
  failureCount  Int       @default(0) @map("failure_count")
  lastUsedAt    DateTime? @map("last_used_at")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isActive], map: "push_subscriptions_user_active_idx")
  @@map("push_subscriptions")
}

// Per-channel delivery attempt for a notification. Server-only audit record;
// retained even after a subscription is deactivated.
model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String  @map("notification_id")
  subscriptionId String? @map("subscription_id")

  channel NotificationChannel
  status  NotificationDeliveryStatus

  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")

  providerStatus Int?    @map("provider_status")
  errorCode      String? @map("error_code")
  errorMessage   String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notification Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationId], map: "notification_deliveries_notification_idx")
  @@index([subscriptionId], map: "notification_deliveries_subscription_idx")
  @@index([status, createdAt], map: "notification_deliveries_status_created_idx")
  @@index([status, nextAttemptAt], map: "notification_deliveries_retry_idx")
  @@map("notification_deliveries")
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL_OFFICE
  LOT
  TOWNHOUSE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  PAUSED
  RENTED
  SOLD
  DRAFT
}

enum PropertyOperationType {
  SALE
  RENT
  SALE_AND_RENT
}

// Core listing record, managed from the dashboard (staff only) and read by the
// public site. Tables are RLS deny-all: every read/write goes through server
// code, which scopes AGENT access to created/assigned listings.
model Property {
  id                String                @id @default(cuid())
  listingId         String                @unique @map("listing_id")
  slug              String                @unique
  title             String
  description       String
  type              PropertyType
  status            PropertyStatus        @default(ACTIVE)
  operationType     PropertyOperationType @map("operation_type")
  salePrice         Decimal?              @map("sale_price") @db.Decimal(14, 2)
  rentPrice         Decimal?              @map("rent_price") @db.Decimal(14, 2)
  // Independent currencies — a SALE_AND_RENT listing can legitimately be
  // priced for sale in USD and for rent in ARS (or any other combination).
  saleCurrency      Currency              @default(USD) @map("sale_currency")
  rentCurrency      Currency              @default(USD) @map("rent_currency")
  location          String
  // Operational area (curated Locations sector). Kept alongside `location`
  // (free-text display string, still the source for public search/cards).
  locationId        String?               @map("location_id")
  fullAddress       String                @map("full_address")
  city              String?
  province          String?
  country           String?
  postalCode        String?               @map("postal_code")
  // Filled by Google Maps geocoding once credentials are available.
  latitude          Decimal?              @db.Decimal(9, 6)
  longitude         Decimal?              @db.Decimal(9, 6)
  bedrooms          Int?
  bathrooms         Int?
  toilets           Int?
  // All measurements in square meters. totalAreaM2 applies to every listing
  // type (whole property area for non-LOT types, parcel area for LOT).
  // coveredAreaM2/semiCoveredAreaM2/lotSizeM2 apply to non-LOT types only;
  // lotFrontageM2/lotDepthM2 apply only when type is LOT.
  totalAreaM2       Int?                  @map("total_area_m2")
  coveredAreaM2     Int?                  @map("covered_area_m2")
  semiCoveredAreaM2 Int?                  @map("semi_covered_area_m2")
  lotSizeM2         Int?                  @map("lot_size_m2")
  lotFrontageM2     Int?                  @map("lot_frontage_m2")
  lotDepthM2        Int?                  @map("lot_depth_m2")
  parkingSpaces     Int?                  @map("parking_spaces")
  yearBuilt         Int?                  @map("year_built")
  floors            Int?
  isFeatured        Boolean               @default(false) @map("is_featured")
  // YouTube/Vimeo/direct video link shown above the map on the public listing page.
  videoUrl          String?               @map("video_url")
  viewsCount        Int                   @default(0) @map("views_count")
  assignedAgentId   String?               @map("assigned_agent_id") @db.Uuid
  ownerContactId    String?               @map("owner_contact_id")
  createdById       String?               @map("created_by_id") @db.Uuid
  updatedById       String?               @map("updated_by_id") @db.Uuid
  // Original WordPress post id for listings migrated from ulrichpropiedades.com
  // (2026-07 migration). NULL = created in-app; never exposed to the frontend.
  wpPostId          String?               @unique @map("wp_post_id")
  publishedAt       DateTime?             @map("published_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  images              PropertyImage[]
  amenities           PropertyAmenity[]
  contacts            ContactProperty[]
  opportunityListings OpportunityListing[]
  leads               Lead[]            @relation("LeadPrimaryListing")
  tours               Tour[]
  operationalLocation Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status], map: "properties_status_idx")
  @@index([type], map: "properties_type_idx")
  @@index([isFeatured], map: "properties_is_featured_idx")
  @@index([assignedAgentId], map: "properties_assigned_agent_idx")
  @@index([createdById], map: "properties_created_by_idx")
  @@index([locationId], map: "properties_location_idx")
  @@map("properties")
}

// One row per stored image; never rely on Storage URLs alone. Optimized to
// WebP at max 2048px before upload (originals are kept only as a fallback
// when optimization fails).
model PropertyImage {
  id               String   @id @default(cuid())
  propertyId       String   @map("property_id")
  url              String
  storagePath      String   @map("storage_path")
  originalFileName String?  @map("original_file_name")
  mimeType         String?  @map("mime_type")
  sizeBytes        Int?     @map("size_bytes")
  width            Int?
  height           Int?
  format           String?
  altText          String?  @map("alt_text")
  sortOrder        Int      @default(0) @map("sort_order")
  isCover          Boolean  @default(false) @map("is_cover")
  createdAt        DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId], map: "property_images_property_idx")
  @@map("property_images")
}

// Canonical amenity catalog (seeded in the migration); listings link via the
// join table so amenity filters stay queryable.
model Amenity {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id")
  amenityId  String @map("amenity_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

// Public users saving/favoriting listings. profileId matches auth.users.id.
// RLS: authenticated user can only read/write their own rows.
model SavedProperty {
  id         String   @id @default(cuid())
  profileId  String   @map("profile_id") @db.Uuid
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([profileId, propertyId], map: "saved_properties_unique")
  @@index([profileId], map: "saved_properties_profile_idx")
  @@map("saved_properties")
}

// Curated office/branch-level operational areas managed from the dashboard's
// Locations page. Property.location stays free-text and neighborhood-grained
// (e.g. "Palermo, Buenos Aires") for public search/display, but each Property
// also links here via locationId for accurate, rename-safe dashboard stats.
model Location {
  id          String   @id @default(cuid())
  locationId  String   @unique @map("location_id")
  name        String
  region      String
  address     String
  postalCode  String   @map("postal_code")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  properties Property[]

  @@map("locations")
}

// ── CRM ────────────────────────────────────────────────────────────────────────

enum ContactType {
  BUYER
  SELLER
  BOTH
}

enum OpportunityStage {
  QUALIFICATION
  VISITATION
  OFFER
  NEGOTIATION
  CLOSING
}

enum OpportunityStatus {
  OPEN
  CLOSED_WON
  CLOSED_LOST
}

enum Currency {
  USD
  ARS
}

// CRM contact — a buyer, seller, or both. Linked to properties via the
// ContactProperty join table and to pipeline records via opportunities.
model Contact {
  id              String      @id @default(cuid())
  contactId       String      @unique @map("contact_id")
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  email           String?
  phone           String?
  location        String?
  address         String?
  type            ContactType @default(BUYER)
  notes           String?
  isDeleted       Boolean     @default(false) @map("is_deleted")
  deletedAt       DateTime?   @map("deleted_at")
  assignedAgentId String?     @map("assigned_agent_id") @db.Uuid
  createdById     String?     @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  properties              ContactProperty[]
  opportunityParticipants OpportunityParticipant[]
  leads                   Lead[]
  tours                   Tour[]

  @@index([email], map: "contacts_email_idx")
  @@index([type], map: "contacts_type_idx")
  @@index([assignedAgentId], map: "contacts_agent_idx")
  @@index([isDeleted], map: "contacts_is_deleted_idx")
  @@map("contacts")
}

// Many-to-many: which contacts are linked to which properties, and in what role.
model ContactProperty {
  contactId  String @map("contact_id")
  propertyId String @map("property_id")
  role       String @default("BUYER")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([contactId, propertyId])
  @@index([propertyId], map: "contact_properties_property_idx")
  @@map("contact_properties")
}

// CRM opportunity — tracks a deal from lead to close.
model Opportunity {
  id                   String            @id @default(cuid())
  opportunityId        String            @unique @map("opportunity_id")
  title                String
  dealType             String?           @map("deal_type")
  dealSize             Decimal?          @map("deal_size") @db.Decimal(14, 2)
  // Currency dealSize/commission are denominated in. Independent of any
  // linked listing's currency — dealSize is a manually-typed figure.
  currency             Currency          @default(USD)
  stage                OpportunityStage  @default(QUALIFICATION)
  status               OpportunityStatus @default(OPEN)
  probability          Int               @default(50)
  commission           Decimal?          @db.Decimal(14, 2)
  commissionUnit       String?           @map("commission_unit")
  paymentTerms         String?           @map("payment_terms")
  contractStart        DateTime?         @map("contract_start")
  contractEnd          DateTime?         @map("contract_end")
  expectedCloseAt      DateTime?         @map("expected_close_at")
  // Stamped once, the first time status transitions into CLOSED_WON. Never
  // touched again afterward — the source of truth for "when this deal closed"
  // (replaces using updatedAt as a fragile stand-in).
  closedAt             DateTime?         @map("closed_at")
  // Dólar Blue "venta" rate locked in at closedAt, for ARS-currency deals only.
  // Frozen permanently so later rate movement never retroactively changes a
  // closed deal's USD figures.
  exchangeRate         Decimal?          @map("exchange_rate") @db.Decimal(10, 4)
  agentCommissionValue Decimal?          @map("agent_commission_value") @db.Decimal(14, 2)
  agentCommissionUnit  String?           @map("agent_commission_unit")
  notes                String?
  isDeleted            Boolean           @default(false) @map("is_deleted")
  deletedAt            DateTime?         @map("deleted_at")
  assignedAgentId      String?           @map("assigned_agent_id") @db.Uuid
  createdById          String?           @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  // Inverse side of Lead.convertedOpportunity — traces this Opportunity back
  // to the Lead it was converted from, when applicable.
  sourceLead   Lead?                    @relation("LeadConversion")
  participants OpportunityParticipant[]
  listings     OpportunityListing[]
  envelopes    DocusignEnvelope[]

  @@index([status], map: "opportunities_status_idx")
  @@index([isDeleted], map: "opportunities_is_deleted_idx")
  @@map("opportunities")
}

enum OpportunityParticipantRole {
  BUYER
  SELLER
  // No Contact record needed — just a free-text company name.
  AGENCY
}

// Multiple parties on one deal (buyer, seller, co-buyers, a co-broking
// agency, etc.) — replaces the old single Opportunity.contactId. BUYER/SELLER
// rows must reference a real Contact; AGENCY rows are just a company name.
model OpportunityParticipant {
  id            String                     @id @default(cuid())
  opportunityId String                     @map("opportunity_id")
  role          OpportunityParticipantRole
  contactId     String?                    @map("contact_id")
  companyName   String?                    @map("company_name")
  // AGENCY rows only — lets a co-broking company be picked as a DocuSign
  // signer, which a bare company name can't support on its own.
  companyEmail  String?                    @map("company_email")
  createdAt     DateTime                   @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([opportunityId], map: "opportunity_participants_opportunity_idx")
  @@index([contactId], map: "opportunity_participants_contact_idx")
  @@map("opportunity_participants")
}

// ── Tours ─────────────────────────────────────────────────────────────────────

enum TourStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A property viewing appointment — links a contact, an optional listing, an
// optional lead, and an assigned agent. Created from the public listing page
// or manually from the dashboard. RLS deny-all (server-only access).
model Tour {
  id         String @id @default(cuid())
  tourNumber String @unique @map("tour_number")

  // Submitted snapshot (preserved even if Contact is later edited)
  submittedName    String  @map("submitted_name")
  submittedEmail   String? @map("submitted_email")
  submittedPhone   String? @map("submitted_phone")
  submittedMessage String? @map("submitted_message")

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  propertyId String?   @map("property_id")
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedAgentId String? @map("assigned_agent_id") @db.Uuid
  createdById     String? @map("created_by_id") @db.Uuid

  status          TourStatus @default(REQUESTED)
  scheduledAt     DateTime   @map("scheduled_at")
  durationMinutes Int        @default(60) @map("duration_minutes")

  // Set when the assigned agent has Google Calendar connected; lets us
  // update/delete the synced event on reschedule/cancel.
  googleCalendarEventId String? @map("google_calendar_event_id")

  confirmationNote   String? @map("confirmation_note")
  rescheduleNote     String? @map("reschedule_note")
  cancellationReason String? @map("cancellation_reason")
  completionNote     String? @map("completion_note")

  rescheduledFrom DateTime? @map("rescheduled_from")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")

  // "PUBLIC_REQUEST" | "DASHBOARD_CREATED"
  source String @default("PUBLIC_REQUEST")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contactId], map: "tours_contact_idx")
  @@index([propertyId], map: "tours_property_idx")
  @@index([leadId], map: "tours_lead_idx")
  @@index([assignedAgentId], map: "tours_agent_idx")
  @@index([status], map: "tours_status_idx")
  @@index([scheduledAt], map: "tours_scheduled_at_idx")
  @@index([createdAt], map: "tours_created_at_idx")
  @@map("tours")
}

// ── Leads ──────────────────────────────────────────────────────────────────────

enum LeadSource {
  WEBSITE_LISTING_INQUIRY
  WEBSITE_CONTACT_FORM
  SCHEDULED_TOUR
  MANUAL
  PHONE
  EMAIL
  WHATSAPP
  REFERRAL
  SOCIAL_MEDIA
  IMPORT
  EXTERNAL_API
  OTHER
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadLifecycleStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  CLOSED
}

// CRM lead — top-of-funnel record linking a potential client to a contact,
// optional listing interest, and an assigned agent. Kept separate from
// Opportunity so temperature / lifecycle tracking stays independent.
model Lead {
  id         String @id @default(cuid())
  leadNumber String @unique @map("lead_number")

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  primaryListingId String?   @map("primary_listing_id")
  primaryListing   Property? @relation("LeadPrimaryListing", fields: [primaryListingId], references: [id], onDelete: SetNull)

  assignedAgentId String? @map("assigned_agent_id") @db.Uuid
  createdById     String? @map("created_by_id") @db.Uuid

  convertedOpportunityId String?      @unique @map("converted_opportunity_id")
  convertedOpportunity   Opportunity? @relation("LeadConversion", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  convertedAt            DateTime?    @map("converted_at")

  // Snapshot of submitted info — preserved even if Contact is updated later.
  submittedName     String  @map("submitted_name")
  submittedEmail    String? @map("submitted_email")
  submittedPhone    String? @map("submitted_phone")
  submittedLocation String? @map("submitted_location")

  source           LeadSource
  sourceDetail     String?    @map("source_detail")
  sourceUrl        String?    @map("source_url")
  externalSource   String?    @map("external_source")
  externalSourceId String?    @map("external_source_id")
  importBatchId    String?    @map("import_batch_id")

  budgetMin Decimal? @map("budget_min") @db.Decimal(14, 2)
  budgetMax Decimal? @map("budget_max") @db.Decimal(14, 2)
  currency  String   @default("ARS")

  score           Int                 @default(0)
  temperature     LeadTemperature     @default(COLD)
  lifecycleStatus LeadLifecycleStatus @default(NEW) @map("lifecycle_status")

  notes           String?
  lastContactedAt DateTime? @map("last_contacted_at")
  nextFollowUpAt  DateTime? @map("next_follow_up_at")
  closedAt        DateTime? @map("closed_at")

  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leadNotes  LeadNote[]
  activities LeadActivity[]
  tours      Tour[]

  @@index([contactId], map: "leads_contact_idx")
  @@index([primaryListingId], map: "leads_listing_idx")
  @@index([assignedAgentId], map: "leads_agent_idx")
  @@index([temperature], map: "leads_temperature_idx")
  @@index([lifecycleStatus], map: "leads_lifecycle_status_idx")
  @@index([source], map: "leads_source_idx")
  @@index([isArchived], map: "leads_is_archived_idx")
  @@index([createdAt], map: "leads_created_at_idx")
  @@index([nextFollowUpAt], map: "leads_next_follow_up_idx")
  @@map("leads")
}

// Individual note on a lead — preserves author and timestamp.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId, createdAt], map: "lead_notes_lead_created_idx")
  @@map("lead_notes")
}

// Immutable audit record for every meaningful lead change.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  fieldName String?  @map("field_name")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt], map: "lead_activities_lead_created_idx")
  @@index([actorId], map: "lead_activities_actor_idx")
  @@map("lead_activities")
}

// ── Blog / CMS ───────────────────────────────────────────────────────────────

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// Manageable editorial taxonomy (dashboard "Manage Categories"). BlogPost.category
// stays a denormalized text column (not a FK) so deleting a category never
// orphans a post — it just clears that post's category to null.
model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_categories")
}

// Editorial content authored from the dashboard Blog module. Body is Tiptap
// HTML. Not yet wired to the public site — the public blog still renders static
// content until this is connected.
model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  // Free text, validated against BlogCategory rows at the action layer. Nullable
  // because deleting a category clears it on posts that referenced it.
  category      String?
  excerpt       String?
  content       String     // Tiptap-authored HTML
  coverImageUrl String?    @map("cover_image_url")
  author        String
  tags          String[]   @default([])
  status        BlogStatus @default(DRAFT)
  // Manually pinned to the hero slot on the public /blog page, ahead of
  // publish-date ordering. Only one post is ever featured at a time — setting
  // this on one post clears it on every other (see toggleBlogFeatured).
  isFeatured    Boolean    @default(false) @map("is_featured")
  // Target publish date/time while status is SCHEDULED; a lazy check on read
  // promotes SCHEDULED -> PUBLISHED once this is in the past (see blog-actions.ts).
  scheduledAt   DateTime?  @map("scheduled_at")
  publishedAt   DateTime?  @map("published_at")
  createdById   String?    @map("created_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([status, publishedAt], map: "blog_posts_status_published_idx")
  @@index([category], map: "blog_posts_category_idx")
  @@index([isFeatured], map: "blog_posts_is_featured_idx")
  @@map("blog_posts")
}

// ── Messaging (staff-to-staff, 1:1 only) ────────────────────────────────────

// One row per unique staff pair. participantOneId/participantTwoId are ALWAYS
// stored with the lexicographically-smaller Profile.id first (enforced in
// message-actions.ts via `[a, b].sort()` before create, not by the DB) so
// getOrCreateConversation can look up existence via the unique constraint
// instead of an OR query.
model Conversation {
  id                 String    @id @default(cuid())
  participantOneId   String    @map("participant_one_id") @db.Uuid
  participantTwoId   String    @map("participant_two_id") @db.Uuid
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([participantOneId, participantTwoId], map: "conversations_pair_unique")
  @@index([participantOneId], map: "conversations_participant_one_idx")
  @@index([participantTwoId], map: "conversations_participant_two_idx")
  @@index([lastMessageAt], map: "conversations_last_message_at_idx")
  @@map("conversations")
}

// Per-user mutable state for a conversation — always exactly 2 rows per
// Conversation (one per participant). Kept separate from Conversation because
// starred/archived/muted/lastReadAt are inherently per-user, not shared.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  profileId      String    @map("profile_id") @db.Uuid
  isStarred      Boolean   @default(false) @map("is_starred")
  isArchived     Boolean   @default(false) @map("is_archived")
  isMuted        Boolean   @default(false) @map("is_muted")
  lastReadAt     DateTime? @map("last_read_at")
  // "Delete conversation" (soft, per-user) — hides it from this participant
  // entirely (active AND archived views), without touching Message rows or
  // the other participant's row. Cleared automatically if either side sends
  // a new message afterward (see message-actions.ts), same spirit as the
  // per-message soft delete on Message.deletedAt.
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId], map: "conversation_participants_unique")
  @@index([profileId, isArchived], map: "conversation_participants_profile_archived_idx")
  @@map("conversation_participants")
}

// A single chat message. recipientId is DENORMALIZED (the other participant)
// — same rationale as Notification.recipientId: lets Realtime filter on a
// single column (recipient_id=eq.userId) and keeps unread-count / grouped-
// push queries a plain `where: { recipientId, readAt: null }` with no join.
model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id") @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt], map: "messages_conversation_created_idx")
  @@index([recipientId, readAt], map: "messages_recipient_read_idx")
  @@index([senderId], map: "messages_sender_idx")
  @@map("messages")
}

// A file/image attached to a Message, stored in Supabase Storage (private
// bucket). Mirrors OpportunityDocument field-for-field, plus width/height for
// image attachments (mirrors PropertyImage).
model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String   @map("message_id")
  fileName    String   @map("file_name")
  storagePath String   @map("storage_path")
  url         String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_message_idx")
  @@map("message_attachments")
}

// ── Opportunity listings + DocuSign ─────────────────────────────────────────
// Contracts (a signing/tracking module) was retired in favor of DocuSign.
// An Opportunity has exactly one contract/signature surface — real DocuSign
// envelopes below — no separate internal-file-upload concept.

// Many-to-many: which properties are linked to an opportunity.
model OpportunityListing {
  opportunityId String @map("opportunity_id")
  propertyId    String @map("property_id")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([opportunityId, propertyId])
  @@index([propertyId], map: "opportunity_listings_property_idx")
  @@map("opportunity_listings")
}

enum EnvelopeStatus {
  SENT
  DELIVERED
  COMPLETED
  DECLINED
  VOIDED
}

// TEMPLATE = sent from a reusable DocuSign template (templateId set).
// CUSTOM_UPLOAD = a one-off PDF/DOC/DOCX uploaded from the CRM and sent via
// DocuSign Free Form Signing (no templateId, no pre-placed tabs — see
// [[docusign-custom-contracts]]).
enum EnvelopeSource {
  TEMPLATE
  CUSTOM_UPLOAD
}

enum EnvelopeRecipientRole {
  BUYER
  SELLER
  AGENT
  THIRD_PARTY
  OTHER
}

// A DocuSign e-signature envelope sent from this app. Status is kept in
// sync by the DocuSign Connect webhook (not polled) — see
// src/app/api/webhooks/docusign/route.ts. Optionally linked to an
// Opportunity ("attach an existing envelope" in the Opportunity modal).
model DocusignEnvelope {
  id                 String         @id @default(cuid())
  docusignEnvelopeId String         @unique @map("docusign_envelope_id")
  source             EnvelopeSource @default(TEMPLATE)
  // Null for CUSTOM_UPLOAD. templateName is required for both sources — it
  // doubles as the generic "what was sent" display title (template name, or
  // the uploaded file's name for a custom contract).
  templateId         String?        @map("template_id")
  templateName       String         @map("template_name")
  // Populated only for CUSTOM_UPLOAD — the original uploaded file.
  documentFileName    String?       @map("document_file_name")
  documentStoragePath String?       @map("document_storage_path")
  documentUrl         String?       @map("document_url")
  documentMimeType    String?       @map("document_mime_type")
  status             EnvelopeStatus @default(SENT)
  // Primary (first-entered) recipient — used for list-view display,
  // notifications, and "My Contracts" matching regardless of source. Full
  // multi-signer detail for CUSTOM_UPLOAD lives in `recipients` below.
  recipientName      String         @map("recipient_name")
  recipientEmail     String         @map("recipient_email")
  propertyReference  String?        @map("property_reference")
  opportunityId      String?        @map("opportunity_id")
  sentById           String?        @map("sent_by_id") @db.Uuid
  sentAt             DateTime       @default(now()) @map("sent_at")
  expiresAt          DateTime?      @map("expires_at")
  completedAt        DateTime?      @map("completed_at")
  voidedReason       String?        @map("voided_reason")
  // Last DocuSign Connect webhook event id applied to this row — dedupes
  // redelivered webhook events so a status is never re-applied twice and a
  // notification never fires twice for the same event.
  lastWebhookEventId String?        @map("last_webhook_event_id")
  // Set by the daily reminder cron once an expiring-soon reminder has been
  // sent — makes the cron idempotent (never reminds twice for one envelope).
  reminderSentAt     DateTime?      @map("reminder_sent_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  opportunity Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  recipients  DocusignEnvelopeRecipient[]

  @@index([opportunityId], map: "docusign_envelopes_opportunity_idx")
  @@index([status], map: "docusign_envelopes_status_idx")
  @@map("docusign_envelopes")
}

// Full signer list for a CUSTOM_UPLOAD envelope (buyer/seller/agent/
// third-party company/other). TEMPLATE envelopes have no rows here — their
// single recipient lives on DocusignEnvelope.recipientName/recipientEmail.
model DocusignEnvelopeRecipient {
  id         String                @id @default(cuid())
  envelopeId String                @map("envelope_id")
  name       String
  email      String
  role       EnvelopeRecipientRole
  // Free-text label shown alongside the role, only meaningful when role = OTHER (e.g. "Notary").
  roleLabel  String?               @map("role_label")
  createdAt  DateTime              @default(now()) @map("created_at")

  envelope DocusignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId], map: "docusign_envelope_recipients_envelope_idx")
  @@map("docusign_envelope_recipients")
}

// Singleton row (fixed id "default") holding the DocuSign "Signature
// Defaults" settings panel. A real table (not env/display-only) because the
// envelope-reminder cron reads autoSendReminders/autoReminderDays.
model DocusignSettings {
  id                  String   @id @default("default")
  defaultExpiryDays   Int      @default(7) @map("default_expiry_days")
  autoReminderDays    Int      @default(3) @map("auto_reminder_days")
  autoSendReminders   Boolean  @default(true) @map("auto_send_reminders")
  emailNotifications  Boolean  @default(true) @map("email_notifications")
  smsNotifications    Boolean  @default(false) @map("sms_notifications")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("docusign_settings")
}

// ── SendGrid email marketing (newsletter/campaign) module ────────────────────
// Audiences, recipients, campaigns and engagement events for the dashboard's
// SendGrid integration. Marketing sends use mailing@ulrichpropiedades.com and
// are fully separate from the transactional/auth emails in src/lib/email.ts —
// a marketing unsubscribe never blocks OTP/reset/invitation mail.

// Deliverability status of a marketing recipient. Lives on the recipient (not
// the list membership) because an unsubscribe/bounce applies to the email
// address globally, across every list. "Removed from a list" is modelled by
// deleting the EmailListMember row, not by a status.
enum EmailRecipientStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  REMOVED
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Per-recipient send outcome within one campaign. Engagement (opened/clicked/
// bounced…) is tracked by the event timestamps on EmailCampaignRecipient, fed
// by the SendGrid Event Webhook.
enum EmailSendStatus {
  PENDING
  SENT
  FAILED
}

// An audience segment ("Contact List" in the UI). The seeded "All Contacts"
// list is isSystem — it cannot be renamed or deleted and every imported
// recipient is auto-added to it.
model EmailList {
  id          String   @id @default(cuid())
  listId      String   @unique @map("list_id")
  name        String
  description String?
  doubleOptIn Boolean  @default(false) @map("double_opt_in")
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members   EmailListMember[]
  campaigns EmailCampaign[]

  @@map("email_lists")
}

// A marketing email recipient, unique by (lowercased) email across the whole
// workspace — the same person in three lists is still one row here.
model EmailRecipient {
  id               String               @id @default(cuid())
  email            String               @unique
  firstName        String?              @map("first_name")
  lastName         String?              @map("last_name")
  phone            String?
  // Free-text city/area — captured from the public website's newsletter
  // signup form (footer "Subscribe"); not asked anywhere else.
  location         String?
  source           String?
  status           EmailRecipientStatus @default(SUBSCRIBED)
  unsubscribedAt   DateTime?            @map("unsubscribed_at")
  bouncedAt        DateTime?            @map("bounced_at")
  // Unguessable token embedded in every campaign email's unsubscribe link.
  unsubscribeToken String               @unique @default(cuid()) @map("unsubscribe_token")
  // Set when the recipient was added from the CRM Contacts module.
  crmContactId     String?              @map("crm_contact_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  memberships        EmailListMember[]
  campaignRecipients EmailCampaignRecipient[]

  @@index([status], map: "email_recipients_status_idx")
  @@map("email_recipients")
}

model EmailListMember {
  listId      String   @map("list_id")
  recipientId String   @map("recipient_id")
  addedById   String?  @map("added_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  list      EmailList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipient EmailRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([listId, recipientId])
  @@index([recipientId], map: "email_list_members_recipient_idx")
  @@map("email_list_members")
}

// A newsletter/marketing campaign. Duplicate-send protection: sendCampaign
// claims the row with an atomic DRAFT→SENDING transition, so a second send of
// the same campaign (double click, two admins) is rejected — resending
// requires an explicit "Duplicate" into a new DRAFT.
model EmailCampaign {
  id            String              @id @default(cuid())
  campaignId    String              @unique @map("campaign_id")
  name          String
  subject       String
  previewText   String?             @map("preview_text")
  fromName      String              @map("from_name")
  fromEmail     String              @map("from_email")
  htmlBody      String              @map("html_body")
  // Which built-in marketing template the body started from (display only).
  templateKey   String?             @map("template_key")
  status        EmailCampaignStatus @default(DRAFT)
  listId        String?             @map("list_id")
  scheduledAt   DateTime?           @map("scheduled_at")
  sendStartedAt DateTime?           @map("send_started_at")
  sentAt        DateTime?           @map("sent_at")
  sentById      String?             @map("sent_by_id") @db.Uuid
  failedReason  String?             @map("failed_reason")
  // SendGrid batch id attached to every personalization of this send.
  sgBatchId     String?             @map("sg_batch_id")
  // Snapshot of how many subscribed recipients the send targeted.
  totalRecipients Int               @default(0) @map("total_recipients")
  lastEventAt   DateTime?           @map("last_event_at")
  createdById   String?             @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  list       EmailList?               @relation(fields: [listId], references: [id], onDelete: SetNull)
  recipients EmailCampaignRecipient[]
  events     EmailCampaignEvent[]

  @@index([status], map: "email_campaigns_status_idx")
  @@map("email_campaigns")
}

// One row per (campaign, email address) the campaign was actually sent to.
// Campaign metrics are COMPUTED from the event timestamps here at read time
// (count of openedAt set, etc.) — no stored counters that can drift.
model EmailCampaignRecipient {
  id             String          @id @default(cuid())
  campaignId     String          @map("campaign_id")
  recipientId    String?         @map("recipient_id")
  email          String
  status         EmailSendStatus @default(PENDING)
  deliveredAt    DateTime?       @map("delivered_at")
  openedAt       DateTime?       @map("opened_at")
  clickedAt      DateTime?       @map("clicked_at")
  bouncedAt      DateTime?       @map("bounced_at")
  droppedAt      DateTime?       @map("dropped_at")
  unsubscribedAt DateTime?       @map("unsubscribed_at")
  spamReportedAt DateTime?       @map("spam_reported_at")
  lastEventAt    DateTime?       @map("last_event_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  campaign  EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient EmailRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email], map: "email_campaign_recipients_campaign_email_key")
  @@index([email], map: "email_campaign_recipients_email_idx")
  @@map("email_campaign_recipients")
}

// Raw SendGrid Event Webhook deliveries, deduped by sg_event_id so a
// redelivered webhook batch can never double-apply an event.
model EmailCampaignEvent {
  id         String   @id @default(cuid())
  sgEventId  String   @unique @map("sg_event_id")
  campaignId String?  @map("campaign_id")
  email      String
  event      String
  timestamp  DateTime
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId], map: "email_campaign_events_campaign_idx")
  @@map("email_campaign_events")
}

// Singleton row (fixed id "default") for the SendGrid Settings tab. The API
// key itself stays in env vars and is never stored or exposed here.
model SendgridSettings {
  id                   String    @id @default("default")
  defaultFromName      String    @default("Ulrich Propiedades") @map("default_from_name")
  defaultFromEmail     String    @default("mailing@ulrichpropiedades.com") @map("default_from_email")
  clickTracking        Boolean   @default(true) @map("click_tracking")
  openTracking         Boolean   @default(true) @map("open_tracking")
  sandboxMode          Boolean   @default(false) @map("sandbox_mode")
  lastConnectionTestAt DateTime? @map("last_connection_test_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("sendgrid_settings")
}
